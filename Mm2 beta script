-- Fling logic (identical to original)
local function u140(p73)
    local char = LocalPlayer11.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = hum and hum.RootPart
    local char3 = p73.Character
    if not char3 then return end
    local Humanoid, RootPart, Head, Handle
    Humanoid = char3:FindFirstChildOfClass("Humanoid")
    if Humanoid and Humanoid.RootPart then RootPart = Humanoid.RootPart end
    Head = char3:FindFirstChild("Head")
    local acc = char3:FindFirstChildOfClass("Accessory")
    if acc and acc:FindFirstChild("Handle") then Handle = acc.Handle end
    if not (char and hum and root) then return end
    if root.Velocity.Magnitude < 50 then getgenv().OldPos = root.CFrame end
    if Humanoid and Humanoid.Sit then return end
    if Head then workspace.CurrentCamera.CameraSubject = Head
    elseif Handle then workspace.CurrentCamera.CameraSubject = Handle
    elseif Humanoid and RootPart then workspace.CurrentCamera.CameraSubject = Humanoid end
    if not char3:FindFirstChildWhichIsA("BasePart") then return end
    local function snap(part, cf1, cf2)
        root.CFrame = CFrame.new(part.Position)*cf1*cf2
        char:SetPrimaryPartCFrame(CFrame.new(part.Position)*cf1*cf2)
        root.Velocity = Vector3.new(90000000,900000000,90000000)
        root.RotVelocity = Vector3.new(900000000,900000000,900000000)
    end
    local function flingLoop(part)
        local ts = tick(); local deg = 0
        repeat
            if root and Humanoid then
                if part.Velocity.Magnitude < 50 then
                    deg = deg+100
                    snap(part,CFrame.new(0,1.5,0)+Humanoid.MoveDirection*part.Velocity.Magnitude/1.25,CFrame.Angles(math.rad(deg),0,0)); task.wait()
                    snap(part,CFrame.new(0,-1.5,0)+Humanoid.MoveDirection*part.Velocity.Magnitude/1.25,CFrame.Angles(math.rad(deg),0,0)); task.wait()
                else
                    snap(part,CFrame.new(0,1.5,Humanoid.WalkSpeed),CFrame.Angles(math.rad(90),0,0)); task.wait()
                    snap(part,CFrame.new(0,-1.5,-Humanoid.WalkSpeed),CFrame.Angles(0,0,0)); task.wait()
                end
            end
        until ts+2 < tick() or not u135
    end
    workspace.FallenPartsDestroyHeight = 0/0
    local bv = Instance.new("BodyVelocity"); bv.Parent = root
    bv.Velocity = Vector3.new(0,0,0); bv.MaxForce = Vector3.new(9e9,9e9,9e9)
    hum:SetStateEnabled(Enum.HumanoidStateType.Seated,false)
    if RootPart then flingLoop(RootPart)
    elseif Head then flingLoop(Head)
    elseif Handle then flingLoop(Handle) end
    bv:Destroy(); hum:SetStateEnabled(Enum.HumanoidStateType.Seated,true)
    workspace.CurrentCamera.CameraSubject = hum
    if getgenv().OldPos then
        repeat
            root.CFrame = getgenv().OldPos*CFrame.new(0,0.5,0)
            char:SetPrimaryPartCFrame(getgenv().OldPos*CFrame.new(0,0.5,0))
            hum:ChangeState("GettingUp")
            for _, c in pairs(char:GetChildren()) do
                if c:IsA("BasePart") then c.RotVelocity = Vector3.new(); c.Velocity = Vector3.new() end
            end
            task.wait()
        until (root.Position - getgenv().OldPos.p).Magnitude < 25
        workspace.FallenPartsDestroyHeight = getgenv().FPDH
    end
end

